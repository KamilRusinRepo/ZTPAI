# Public credentials for the local database in compose.yaml:
DATABASE_URL=postgres://room_booking:example_password@localhost:5432/room_booking
NODE_ENV=development
PORT=3000
REPOSITORY_DRIVER=knex
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
ENABLE_DEBUG_ROUTES=false
SEED_STARTED_RESERVATION=false
# Optional double-booking script settings:
BASE_URL=http://localhost:3000
# ACCESS_TOKEN=<paste-a-fresh-access-token>
