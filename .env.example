# Public demonstration values; change passwords and JWT_SECRET for deployment.
# DB_USER/DB_PASSWORD/DB_NAME are used by Docker Compose (use URL-safe values).
DB_USER=room_booking
DB_PASSWORD=example_password
DB_NAME=room_booking
DB_PORT=5433
# For API started directly on the host; Compose uses db:5432 inside its network.
DATABASE_URL=postgres://room_booking:example_password@localhost:5433/room_booking
# Osobna baza dla testów integracyjnych
TEST_DATABASE_URL=postgres://room_booking:example_password@127.0.0.1:55432/room_booking_test
NODE_ENV=development
PORT=3000
REPOSITORY_DRIVER=knex
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
ENABLE_DEBUG_ROUTES=false
SEED_STARTED_RESERVATION=false
# Optional double-booking script settings:
BASE_URL=http://localhost:3000
# ACCESS_TOKEN=<paste-a-fresh-access-token>
