{
  "name": "room-booking-api",
  "version": "1.0.0",
  "private": true,
  "description": "Zadanie 01 — REST API sal i rezerwacji",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:seed": "node scripts/start-seeded.js",
    "dev": "node --watch src/server.js",
