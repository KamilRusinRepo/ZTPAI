    "verify:task5": "node scripts/verify-task5.js",
    "verify:task2": "node scripts/verify-task2.js",
    "verify:task3": "node scripts/verify-task3.js",
    "evidence": "node scripts/evidence.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
