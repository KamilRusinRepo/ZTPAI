{
  "name": "room-booking-api",
  "version": "1.0.0",
  "private": true,
  "description": "Zadanie 01 — REST API sal i rezerwacji",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:seed": "node scripts/start-seeded.js",
    "dev": "node --watch src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "test:db:up": "docker compose -p room-booking-tests -f tests/compose.yaml up -d --wait",
    "test:db:down": "docker compose -p room-booking-tests -f tests/compose.yaml down",
    "test:legacy": "node --test test/*.test.js tests/*.test.js",
    "verify:events": "node scripts/verify-audit-events.js",
    "verify:auth-register": "node scripts/verify-auth-registration.js",
    "verify:auth-login": "node scripts/verify-auth-login.js",
    "verify:auth-reservations": "node scripts/verify-auth-reservations.js",
    "verify:authorization": "node scripts/verify-authorization.js",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "seed:run": "knex seed:run",
    "double-booking": "node scripts/double-booking.js",
    "verify:task5": "node scripts/verify-task5.js",
    "verify:task2": "node scripts/verify-task2.js",
    "verify:task3": "node scripts/verify-task3.js",
    "evidence": "node scripts/evidence.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
